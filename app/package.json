{
  "name": "agent-meeting-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Attention-centric meeting-style workspace for parallel coding agents (MVP)",
  "main": "out/main/index.cjs",
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && bash scripts/electron.sh",
    "dev": "npm run build:main && bash scripts/dev.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "smoke:providers": "node scripts/build-main.mjs && node out/smoke/providers.cjs",
    "smoke:voice": "node scripts/build-main.mjs && node out/smoke/voice.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "zod": "4.6.7",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "esbuild": "0.27.7",
    "playwright-core": "1.58.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
