{
  "name": "agent-workspace",
  "version": "0.15.5",
  "private": true,
  "description": "Run Claude Code and Codex agents in parallel from one meeting-style workspace, with a main agent and always-on voice.",
  "main": "out/main/index.cjs",
  "license": "AGPL-3.0-only",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && bash scripts/electron.sh",
    "demo": "npm run build && AMW_MODE=demo bash scripts/electron.sh",
    "dev": "npm run build:main && bash scripts/dev.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "smoke:providers": "node scripts/build-main.mjs && node out/smoke/providers.cjs",
    "smoke:voice": "node scripts/build-main.mjs && node out/smoke/voice.cjs",
    "smoke:content": "node scripts/build-main.mjs && node out/smoke/content.cjs",
    "dist:mac": "bash scripts/dist.sh --mac",
    "dist:win": "bash scripts/dist.sh --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.3",
    "remark-gfm": "4.0.1",
    "sherpa-onnx-node": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.27.7",
    "playwright-core": "1.58.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "shiki": "4.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "author": {
    "name": "Flitternie",
    "email": "flitternie@gmail.com"
  },
  "homepage": "https://github.com/Flitternie/agent-workspace",
  "build": {
    "appId": "com.flitternie.agentworkspace",
    "productName": "Agent Workspace",
    "copyright": "© 2026 Flitternie",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json",
      "!out/smoke/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Agent Workspace listens so you can talk to your coding agents. Only speech is transcribed.",
        "NSDocumentsFolderUsageDescription": "A coding agent you started in Agent Workspace is working with files in your Documents folder.",
        "NSDesktopFolderUsageDescription": "A coding agent you started in Agent Workspace is working with files on your Desktop.",
        "NSDownloadsFolderUsageDescription": "A coding agent you started in Agent Workspace is working with files in your Downloads folder.",
        "NSRemovableVolumesUsageDescription": "A coding agent you started in Agent Workspace is working with files on an external drive.",
        "NSNetworkVolumesUsageDescription": "A coding agent you started in Agent Workspace is working with files on a network drive.",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      }
    },
    "dmg": {
      "artifactName": "Agent-Workspace-${version}-${arch}.${ext}",
      "title": "Agent Workspace ${version}",
      "background": "build/background.tiff",
      "icon": "build/icon.icns",
      "iconSize": 112,
      "writeUpdateInfo": false,
      "window": {
        "x": 200,
        "y": 120,
        "width": 660,
        "height": 540
      },
      "contents": [
        {
          "x": 170,
          "y": 210,
          "type": "file"
        },
        {
          "x": 490,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Agent-Workspace-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent Workspace",
      "differentialPackage": false
    },
    "publish": null
  }
}
