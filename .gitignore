# Secrets: never commit keys or local env files
openai.key
*.key
*.pem
.env
.env.*

# Local tool / editor state
.DS_Store
.claude/
.vscode/
.idea/
*.log

# Reference repos cloned for research (read-only, not ours)
research/

# Dependencies, builds and app-owned runtime data
node_modules/
app/out/
app/.cache/
app/.data/
app/.data-demo/
app/.models/
app/test-results/
app/.npmrc.local
coverage/

# Developer-only documents (specs, research notes, build logs) stay local
agent_workspace_spec/
AGENT_WORKSPACE_FULL_SPEC.md
SPIKE_REPORT.md
IMPLEMENTATION_LOG.md

# Packaging output
app/release/

# Design work stays local: only the finished assets the build uses
# (app/build/icon.icns, icon.png, background.tiff) are committed.
app/build/*
!app/build/icon.icns
!app/build/icon.png
!app/build/background.tiff
app/scripts/render-assets.sh
app/scripts/assets/

# Promo video work (sources, renders, voiceover) stays local
video/
